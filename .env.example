# Required in production. Shared by the team and every agent.
ORBIT_API_KEY=

# Owner-only monthly bills, as JSON. Anyone without the key above never sees these;
# they can add their own bills in the dashboard (stored in their browser only).
ORBIT_BILLS={"floor":0,"personal":0}

# Added automatically when you connect Upstash for Redis in Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: mirror every event into the Collective Vault MCP server.
VAULT_MCP_URL=
VAULT_MCP_TOKEN=
VAULT_LOG_TOOL=vault_log
VAULT_LOG_FIELD=entry
VAULT_LOG_EXTRA={}
